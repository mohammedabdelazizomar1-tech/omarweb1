@model BusinessManagement.Application.DTOs.CreateJournalEntryDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "إنشاء قيد يومية عام يدوي";
    var accounts = ViewBag.Accounts as IEnumerable<BusinessManagement.Application.DTOs.AccountDto> ?? new List<BusinessManagement.Application.DTOs.AccountDto>();
}

<div class="container-fluid py-4 text-right" style="max-width: 900px;">
    <div class="glass-card p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--border-color);">
            <h5 class="text-white fw-bold m-0"><i class="bi bi-file-earmark-plus text-primary me-2"></i> إضافة قيد يومية مزدوج يدوي</h5>
            <a href="/Accounting" class="btn btn-outline-secondary btn-sm">إلغاء والعودة</a>
        </div>

        <form id="journalEntryForm" onsubmit="submitJournal(event)">
            @Html.AntiForgeryToken()

            <!-- Date and Narration -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="EntryDate" class="form-label text-secondary small">تاريخ القيد *</label>
                    <input asp-for="EntryDate" type="date" class="form-control" value="@Model.EntryDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-8">
                    <label asp-for="Narration" class="form-label text-secondary small">البيان / شرح القيد بالتفصيل *</label>
                    <input asp-for="Narration" class="form-control" placeholder="مثال: سداد مصروفات استخراج كود البوابة أو تمويل الخزينة الرئيسية..." required />
                </div>
            </div>

            <!-- Ledger Lines Header -->
            <h6 class="text-white fw-bold pb-2 mb-3" style="border-bottom: 1px solid var(--border-color);">حركات القيد المزدوج (مدين / دائن)</h6>

            <div class="table-responsive mb-4">
                <table class="BusinessManagement-table table-sm align-middle text-nowrap m-0" id="linesTable">
                    <thead>
                        <tr class="text-secondary">
                            <th style="width: 45%;">الحساب المالي</th>
                            <th style="width: 25%;" class="text-end">مدين (Debit)</th>
                            <th style="width: 25%;" class="text-end">دائن (Credit)</th>
                            <th style="width: 5%;" class="text-center">إجراء</th>
                        </tr>
                    </thead>
                    <tbody id="linesContainer">
                        <!-- Initial Rows (Standard double-entry needs at least 2 rows) -->
                        <tr class="entry-line-row">
                            <td>
                                <select class="form-select account-selector" required>
                                    <option value="">اختر الحساب...</option>
                                    @foreach (var a in accounts)
                                    {
                                        <option value="@a.Id">@a.AccountCode - @a.Name (@a.Type)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control text-end debit-input" placeholder="0.00" oninput="debitChanged(this)" />
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control text-end credit-input" placeholder="0.00" oninput="creditChanged(this)" />
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger p-1" onclick="removeRow(this)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                        <tr class="entry-line-row">
                            <td>
                                <select class="form-select account-selector" required>
                                    <option value="">اختر الحساب...</option>
                                    @foreach (var a in accounts)
                                    {
                                        <option value="@a.Id">@a.AccountCode - @a.Name (@a.Type)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control text-end debit-input" placeholder="0.00" oninput="debitChanged(this)" />
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" class="form-control text-end credit-input" placeholder="0.00" oninput="creditChanged(this)" />
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger p-1" onclick="removeRow(this)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="border-top: 1px solid var(--border-color) !important;">
                            <td>
                                <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="addRow()"><i class="bi bi-plus-lg"></i> إضافة سطر جديد</button>
                            </td>
                            <td class="text-end fw-bold text-success" id="totalDebitHUD">0.00 ج.م</td>
                            <td class="text-end fw-bold text-info" id="totalCreditHUD">0.00 ج.م</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Balance Verification Alert -->
            <div id="balanceAlert" class="alert border-0 text-center py-2 mb-4" style="background-color: rgba(239, 68, 68, 0.1); color: #f87171;">
                القيد غير متزن حالياً! الفارق: <span id="balanceDiff">0.00</span> ج.م
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" id="submitBtn" disabled>حفظ قيد اليومية كمسودة</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function debitChanged(input) {
            const row = input.closest('tr');
            const creditInput = row.querySelector('.credit-input');
            if (parseFloat(input.value) > 0) {
                creditInput.value = '';
                creditInput.disabled = true;
            } else {
                creditInput.disabled = false;
            }
            updateSums();
        }

        function creditChanged(input) {
            const row = input.closest('tr');
            const debitInput = row.querySelector('.debit-input');
            if (parseFloat(input.value) > 0) {
                debitInput.value = '';
                debitInput.disabled = true;
            } else {
                debitInput.disabled = false;
            }
            updateSums();
        }

        function removeRow(btn) {
            const rows = document.querySelectorAll('.entry-line-row');
            if (rows.length <= 2) {
                alert('الحد الأدنى لقيد القيد المزدوج هو سطرين ماليين.');
                return;
            }
            btn.closest('tr').remove();
            updateSums();
        }

        function addRow() {
            const container = document.getElementById('linesContainer');
            const template = container.firstElementChild.cloneNode(true);
            
            // Clear values and reset state
            template.querySelector('.account-selector').value = '';
            
            const debitInput = template.querySelector('.debit-input');
            debitInput.value = '';
            debitInput.disabled = false;
            
            const creditInput = template.querySelector('.credit-input');
            creditInput.value = '';
            creditInput.disabled = false;

            container.appendChild(template);
        }

        function updateSums() {
            let totalDebit = 0;
            let totalCredit = 0;

            document.querySelectorAll('.debit-input').forEach(input => {
                totalDebit += parseFloat(input.value) || 0;
            });
            document.querySelectorAll('.credit-input').forEach(input => {
                totalCredit += parseFloat(input.value) || 0;
            });

            document.getElementById('totalDebitHUD').textContent = `${totalDebit.toFixed(2)} ج.م`;
            document.getElementById('totalCreditHUD').textContent = `${totalCredit.toFixed(2)} ج.م`;

            const alertEl = document.getElementById('balanceAlert');
            const diffEl = document.getElementById('balanceDiff');
            const submitBtn = document.getElementById('submitBtn');

            const difference = Math.abs(totalDebit - totalCredit);
            
            if (difference < 0.01 && totalDebit > 0) {
                alertEl.style.backgroundColor = 'rgba(16, 185, 129, 0.1)';
                alertEl.style.color = '#34d399';
                alertEl.textContent = 'القيد متزن وجاهز للحفظ!';
                submitBtn.disabled = false;
            } else {
                alertEl.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
                alertEl.style.color = '#f87171';
                alertEl.innerHTML = `القيد غير متزن حالياً! الفارق: <strong>${difference.toFixed(2)}</strong> ج.م`;
                submitBtn.disabled = true;
            }
        }

        async function submitJournal(event) {
            event.preventDefault();

            const form = document.getElementById('journalEntryForm');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;

            const lines = [];
            document.querySelectorAll('.entry-line-row').forEach(row => {
                const accId = row.querySelector('.account-selector').value;
                const debit = parseFloat(row.querySelector('.debit-input').value) || 0;
                const credit = parseFloat(row.querySelector('.credit-input').value) || 0;

                if (accId) {
                    lines.push({ accountId: accId, debit: debit, credit: credit });
                }
            });

            const payload = {
                entryDate: document.getElementById('EntryDate').value,
                narration: document.getElementById('Narration').value,
                lines: lines
            };

            try {
                const response = await fetch('/Accounting/CreateJournalEntry', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                
                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    location.href = '/Accounting/JournalEntries';
                } else {
                    alert(result.message);
                    submitBtn.disabled = false;
                }
            } catch (error) {
                console.error('Error submitting journal entry:', error);
                alert('حدث خطأ أثناء حفظ القيد.');
                submitBtn.disabled = false;
            }
        }
    </script>
}
