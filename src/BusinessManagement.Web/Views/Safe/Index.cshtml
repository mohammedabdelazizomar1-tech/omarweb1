        // Syncs DOM selections and states based on selectedBookingIds array
        function syncSelection() {
            const countText = document.getElementById("selectedBookingsCountText");
            const countGroupsText = document.getElementById("selectedGroupsCountText");
            const typeSelect = document.getElementById("transactionTypeSelect");
            const currencySelect = document.getElementById("currencySelect");
            const partnerSelect = document.getElementById("partnerSelect");
            
            const generalRow = document.getElementById("generalAmountDepositorRow");
            const amountInput = document.getElementById("amountInput");
            const depositorNameInput = document.getElementById("depositorNameInput");
            
            const bookingWrapper = document.getElementById("bookingWrapper");
            const hiddenContainer = document.getElementById("hiddenBookingIdsContainer");

            const groupInputsRow = document.getElementById("groupInputsRow");
            const groupPassengersList = document.getElementById("groupPassengersList");

            const individualInputsRow = document.getElementById("individualInputsRow");
            const individualPassengersList = document.getElementById("individualPassengersList");

            // Clear hidden inputs
            hiddenContainer.innerHTML = "";

            const partnerId = partnerSelect.value;

            if (!partnerId) {
                // Not in booking mode (General Company Safe)
                if (countText) {
                    countText.textContent = "اختر الأفراد... (0 محدد)";
                    countText.className = "text-muted";
                }
                if (countGroupsText) {
                    countGroupsText.textContent = "اختر المجموعات... (0 محدد)";
                    countGroupsText.className = "text-muted";
                }

                typeSelect.removeAttribute("disabled");
                currencySelect.removeAttribute("disabled");
                partnerSelect.removeAttribute("disabled");

                // Show general inputs row & make them required
                generalRow.classList.remove("d-none");
                amountInput.setAttribute("required", "true");
                depositorNameInput.setAttribute("required", "true");

                // Reset booking-related fields
                const overallInput = document.getElementById("overallAmountInput");
                if (overallInput) overallInput.value = "";
                if (groupInputsRow) groupInputsRow.classList.add("d-none");
                if (groupPassengersList) groupPassengersList.innerHTML = "";
                if (individualInputsRow) individualInputsRow.classList.add("d-none");
                if (individualPassengersList) individualPassengersList.innerHTML = "";

                bookingWrapper.classList.add("d-none");
                return;
            }

            // Booking Mode (Partner selected)
            bookingWrapper.classList.remove("d-none");

            // Hide general inputs row and disable standard validations
            generalRow.classList.add("d-none");
            amountInput.removeAttribute("required");
            depositorNameInput.removeAttribute("required");

            // Lock controls
            typeSelect.value = "Deposit";
            typeSelect.setAttribute("disabled", "true");
            currencySelect.value = "EGP";
            adjustExchangeRateInput("EGP");
            currencySelect.setAttribute("disabled", "true");

            // Sync hidden inputs for model binding
            selectedBookingIds.forEach(id => {
                const hidden = document.createElement("input");
                hidden.type = "hidden";
                hidden.name = "BookingIds";
                hidden.value = id;
                hiddenContainer.appendChild(hidden);
            });

            // Find matching bookings
            const selectedBookings = allActiveBookings.filter(b => selectedBookingIds.includes(b.id));

            // Sync Groups Count Text
            const selectedGroups = [...new Set(selectedBookings.map(b => b.groupNumber).filter(g => g && g.trim() !== ""))];
            if (countGroupsText) {
                if (selectedGroups.length > 0) {
                    countGroupsText.textContent = `${selectedGroups.length} مجموعات محددة`;
                    countGroupsText.className = "text-dark fw-bold";
                } else {
                    countGroupsText.textContent = "اختر المجموعات... (0 محدد)";
                    countGroupsText.className = "text-muted";
                }
            }

            // Sync Individuals Count Text
            const selectedIndividuals = selectedBookings.filter(b => !b.groupNumber || b.groupNumber.trim() === "");
            if (countText) {
                if (selectedIndividuals.length > 0) {
                    countText.textContent = `${selectedIndividuals.length} أفراد محددة`;
                    countText.className = "text-dark fw-bold";
                } else {
                    countText.textContent = "اختر الأفراد... (0 محدد)";
                    countText.className = "text-muted";
                }
            }

            if (selectedBookings.length > 0) {
                partnerSelect.value = selectedBookings[0].partnerId;
                partnerSelect.setAttribute("disabled", "true");
            }

            // Clear Lists
            groupPassengersList.innerHTML = "";
            individualPassengersList.innerHTML = "";

            // Grouping selected bookings
            let groupedMap = {};
            let individualList = [];

            selectedBookings.forEach(b => {
                if (b.groupNumber && b.groupNumber.trim() !== "") {
                    const grp = b.groupNumber.trim();
                    if (!groupedMap[grp]) {
                        groupedMap[grp] = [];
                    }
                    groupedMap[grp].push(b);
                } else {
                    individualList.push(b);
                }
            });

            // 1. Render Groups Section
            const uniqueGroupKeys = Object.keys(groupedMap);
            if (uniqueGroupKeys.length > 0) {
                // Keep global groupInputsRow hidden (do not remove d-none)
                
                uniqueGroupKeys.forEach(groupNum => {
                    const bookingsInGrp = groupedMap[groupNum];
                    
                    const groupSubCard = document.createElement("div");
                    groupSubCard.className = "group-card-border text-dark";

                    const passengerRowsHtml = bookingsInGrp.map(b => {
                        const savedVal = bookingPaymentsMap[b.id] !== undefined ? bookingPaymentsMap[b.id] : b.remainingBalance;
                        bookingPaymentsMap[b.id] = savedVal; // sync default

                        return `
                            <div class="row g-2 align-items-center booking-payment-row pb-2 border-bottom border-secondary mb-2" id="row_b_${b.id}" data-booking-id="${b.id}" data-group="${groupNum}">
                                <div class="col-6">
                                    <span class="fw-semibold text-dark small d-block">${b.passengerName}</span>
                                    <span class="text-muted" style="font-size: 0.72rem;">حجز: ${b.bookingNumber}</span>
                                </div>
                                <div class="col-3 text-muted small text-end">
                                    <span>المتبقي: ${b.remainingBalance.toFixed(2)} ج.م</span>
                                </div>
                                <div class="col-3">
                                    <input type="number" class="form-control form-control-sm booking-payment-amount" name="BookingPayments[${b.id}]" data-booking-id="${b.id}" data-group="${groupNum}" data-remaining="${b.remainingBalance}" placeholder="الدفعة" required step="0.01" min="0" max="${b.remainingBalance}" value="${savedVal.toFixed(2)}" oninput="onPassengerPaymentInput('${b.id}', this.value)" />
                                </div>
                            </div>
                        `;
                    }).join("");

                    groupSubCard.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                            <span class="fw-bold text-secondary text-start" style="font-size: 0.85rem;">مجموعة: ${groupNum}</span>
                            <div class="d-flex align-items-center gap-2">
                                <label class="small text-muted mb-0" style="font-size: 0.75rem;">المبلغ الإجمالي للمجموعة:</label>
                                <input type="number" id="groupTotalAmountInput_${groupNum}" step="0.01" class="form-control form-control-sm text-end fw-bold border-primary text-dark" 
                                       placeholder="0.00" style="width: 120px; height: 28px; background-color: rgba(13, 110, 253, 0.05);"
                                       oninput="distributeSpecificGroupAmount('${groupNum}', this.value)" onchange="syncSectionTotalAmountInputs(); calculateTotalAmountFromRows();" />
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-2">${passengerRowsHtml}</div>
                    `;
                    groupPassengersList.appendChild(groupSubCard);
                });
            } else {
                document.getElementById("groupTotalAmountInput").value = "";
                document.getElementById("groupDepositorNameInput").value = "";
            }

            // 2. Render Individuals Section
            if (individualList.length > 0) {
                individualInputsRow.classList.remove("d-none");

                const indRowsHtml = individualList.map(b => {
                    const savedVal = bookingPaymentsMap[b.id] !== undefined ? bookingPaymentsMap[b.id] : b.remainingBalance;
                    bookingPaymentsMap[b.id] = savedVal;

                    return `
                        <div class="row g-2 align-items-center booking-payment-row pb-2 border-bottom border-secondary mb-2" id="row_b_${b.id}" data-booking-id="${b.id}">
                            <div class="col-6">
                                <span class="fw-semibold text-dark small d-block">${b.passengerName}</span>
                                <span class="text-muted" style="font-size: 0.72rem;">حجز: ${b.bookingNumber}</span>
                            </div>
                            <div class="col-3 text-muted small text-end">
                                <span>المتبقي: ${b.remainingBalance.toFixed(2)} ج.م</span>
                            </div>
                            <div class="col-3">
                                <input type="number" class="form-control form-control-sm booking-payment-amount" name="BookingPayments[${b.id}]" data-booking-id="${b.id}" data-remaining="${b.remainingBalance}" placeholder="الدفعة" required step="0.01" min="0" max="${b.remainingBalance}" value="${savedVal.toFixed(2)}" oninput="onPassengerPaymentInput('${b.id}', this.value)" />
                            </div>
                        </div>
                    `;
                }).join("");

                individualPassengersList.innerHTML = indRowsHtml;
            } else {
                individualInputsRow.classList.add("d-none");
                document.getElementById("individualTotalAmountInput").value = "";
                document.getElementById("individualDepositorNameInput").value = "";
            }

            bookingWrapper.classList.remove("d-none");

            // Auto-populate group depositor name with the checked group passengers
            const groupBookings = selectedBookings.filter(b => b.groupNumber && b.groupNumber.trim() !== "");
            const groupNames = [...new Set(groupBookings.map(b => b.passengerName))];
            const groupDepInput = document.getElementById("groupDepositorNameInput");
            if (groupDepInput) {
                groupDepInput.value = groupNames.join(" / ");
            }

            // Auto-populate individual depositor name with the checked individual passengers
            const individualBookings = selectedBookings.filter(b => !b.groupNumber || b.groupNumber.trim() === "");
            const individualNames = [...new Set(individualBookings.map(b => b.passengerName))];
            const individualDepInput = document.getElementById("individualDepositorNameInput");
            if (individualDepInput) {
                individualDepInput.value = individualNames.join(" / ");
            }

            // General depositor backup
            // Build list of all passenger names
            let passengerNames = [];
            selectedBookings.forEach(b => {
                if (b.passengerName && !passengerNames.includes(b.passengerName)) {
                    passengerNames.push(b.passengerName);
                }
            });

            if (passengerNames.length > 0) {
                depositorNameInput.value = passengerNames.join(" / ");
            }

            calculateTotalAmountFromRows();
            syncSectionTotalAmountInputs();
            amountInput.removeAttribute("readonly");
        }

        // Passenger individual payment change handler
        function onPassengerPaymentInput(bookingId, value) {
            const val = parseFloat(value) || 0;
            bookingPaymentsMap[bookingId] = val;
            
            syncSectionTotalAmountInputs();
            calculateTotalAmountFromRows();
        }

        async function submitSafeForm(event, form) {
            event.preventDefault();

            // Temporary enable disabled fields to serialize them
            const disabledInputs = form.querySelectorAll(':disabled');
            disabledInputs.forEach(i => i.removeAttribute('disabled'));

            const formData = new FormData(form);

            // Re-disable
            disabledInputs.forEach(i => i.setAttribute('disabled', 'true'));

            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            try {
                const result = await BusinessManagementAjax(form.action, form.method, formData);
                if (result.success) {
                    BusinessManagementAlert(result.message, "success");
                    const modalEl = document.getElementById("safeModalElement");
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    BusinessManagementAlert(result.message, "danger");
                    submitBtn.disabled = false;
                }
            } catch (error) {
                console.error("Safe form submit error:", error);
                submitBtn.disabled = false;
            }
        }

        // AJAX Deletion
        async function deleteTransaction(id) {
            if (window.Swal) {
                const swalResult = await Swal.fire({
                    title: 'تأكيد الحذف',
                    text: 'هل أنت متأكد من حذف قيد هذه الحركة من الخزينة؟',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، احذف',
                    cancelButtonText: 'إلغاء',
                    customClass: {
                        popup: 'bms-swal-confirm',
                        confirmButton: 'btn btn-danger',
                        cancelButton: 'btn btn-outline-secondary'
                    },
                    buttonsStyling: false
                });

                if (!swalResult.isConfirmed) return;
            } else {
                if (!confirm("هل أنت متأكد من حذف قيد هذه الحركة من الخزينة؟")) {
                    return;
                }
            }

            try {
                const result = await BusinessManagementAjax(`/Safe/Delete/${id}`, "POST");
                if (result.success) {
                    BusinessManagementAlert(result.message, "success");
                    setTimeout(() => location.reload(), 1000);
                } else {
                    BusinessManagementAlert(result.message, "danger");
                }
            } catch (error) {
                console.error("Safe deletion error:", error);
            }
        }

        function printDisplayedSafeTransactions() {
            const visibleRows = Array.from(document.querySelectorAll(".safe-row")).filter(row => row.style.display !== "none");
            if (visibleRows.length === 0) {
                if (window.BusinessManagementAlert) {
                    BusinessManagementAlert("لا توجد حركات خزينة معروضة حالياً للطباعة.", "warning");
                } else {
                    alert("لا توجد حركات خزينة معروضة حالياً للطباعة.");
                }
                return;
            }
            const ids = visibleRows.map(row => row.getAttribute("data-id")).join(",");
            window.open(`/Safe/PrintBulk?ids=${ids}`, '_blank');
        }
    </script>
}
