@model BusinessManagement.Application.DTOs.SafeTransactionDto
@{
    Layout = null;
    var isDeposit = Model.TransactionType == "Deposit";
    var voucherTitle = isDeposit ? "سند قبض نقدية" : "سند صرف نقدية";
    var partyLabel = isDeposit ? "مستلم من السيد/الجهة" : "مدفوع إلى السيد/الجهة";
    var egpValue = Model.Currency == "EGP" ? Model.Amount : Model.Amount * Model.ExchangeRate;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@voucherTitle - @Model.Id.ToString().Substring(0, 8).ToUpper()</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #fff;
            color: #000;
            padding: 20px;
        }
        .receipt-container {
            border: 2px solid #2b2d42;
            padding: 30px;
            border-radius: 12px;
            max-width: 800px;
            margin: 0 auto;
            position: relative;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }
        .receipt-container::after {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle, rgba(0,0,0,0.01) 20%, transparent 20%);
            background-size: 10px 10px;
            pointer-events: none;
            z-index: -1;
        }
        .receipt-header {
            border-bottom: 2px solid #2b2d42;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .receipt-logo-area {
            font-size: 1.3rem;
            font-weight: 800;
            color: #2b2d42;
        }
        .voucher-badge {
            background-color: #2b2d42;
            color: #fff;
            padding: 8px 25px;
            border-radius: 6px;
            font-size: 1.25rem;
            font-weight: 700;
            text-align: center;
        }
        .meta-text {
            font-size: 0.9rem;
            color: #333;
        }
        .highlight-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 12px 18px;
            font-weight: 700;
            font-size: 1.15rem;
        }
        .detail-row {
            border-bottom: 1px dashed #dee2e6;
            padding: 12px 5px;
            font-size: 1.05rem;
        }
        .detail-label {
            font-weight: 700;
            color: #495057;
            width: 180px;
            display: inline-block;
        }
        .detail-val {
            color: #212529;
        }
        .signatures-section {
            margin-top: 40px;
            border-top: 2px solid #dee2e6;
            padding-top: 20px;
        }
        .sig-box {
            text-align: center;
            font-size: 0.95rem;
            font-weight: 600;
        }
        .official-stamp {
            border: 2px dashed #adb5bd;
            border-radius: 50%;
            width: 90px;
            height: 90px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #adb5bd;
            font-size: 0.8rem;
            font-weight: bold;
        }
        @@media print {
            body {
                padding: 0 !important;
                margin: 0 !important;
                background-color: #fff !important;
                color: #000 !important;
            }
            .receipt-container {
                border: 2px solid #000 !important;
                box-shadow: none !important;
                max-width: 100% !important;
                border-radius: 0 !important;
                padding: 15px 20px !important;
                margin: 0 auto !important;
            }
            .receipt-container::after {
                display: none !important;
            }
            .no-print {
                display: none !important;
            }
            .highlight-box {
                background-color: #f8f9fa !important;
                border: 1px solid #000 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .detail-row {
                padding: 8px 5px !important;
                border-bottom: 1px dashed #000 !important;
            }
            .signatures-section {
                margin-top: 20px !important;
                border-top: 2px solid #000 !important;
            }
            body, p, div, span, td, th {
                color: #000 !important;
            }
            table, th, td {
                border-color: #000 !important;
            }
            thead th {
                background-color: #2b2d42 !important;
                color: #fff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <!-- Actions (Screen Only) -->
    <div class="no-print text-center mb-4" style="max-width: 800px; margin: 0 auto;">
        <button onclick="window.print();" class="btn btn-dark px-4 me-2">
            طباعة السند
        </button>
        <button onclick="window.close();" class="btn btn-outline-secondary px-4">إغلاق</button>
    </div>

    <!-- Printable Receipt -->
    <div class="receipt-container">
        <!-- Header -->
        <div class="receipt-header row align-items-center">
            <div class="col-md-5 col-5">
                <div class="receipt-logo-area">شركة إدارة الأعمال والخدمات السياحية</div>
                <div class="meta-text text-muted">دفتر الخزينة والمعاملات المالية العامة</div>
            </div>
            <div class="col-md-4 col-4 text-center">
                <div class="voucher-badge shadow-sm">@voucherTitle</div>
            </div>
            <div class="col-md-3 col-3 text-end">
                <div class="meta-text"><strong>رقم السند:</strong> ST-@Model.Id.ToString().Substring(0, 8).ToUpper()</div>
                <div class="meta-text"><strong>التاريخ:</strong> @Model.TransactionDate.ToString("dd MMMM yyyy")</div>
            </div>
        </div>

        <!-- Amount Highlight -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-7 col-7">
                <div class="highlight-box">
                    <span>المبلغ المستلم/المدفوع: </span>
                    <span class="text-dark">@Model.Amount.ToString("N2") @Model.Currency</span>
                </div>
            </div>
            <div class="col-md-5 col-5 text-end">
                @if (Model.Currency != "EGP")
                {
                    <div class="text-muted small">
                        <strong>سعر الصرف للجنيه:</strong> @Model.ExchangeRate.ToString("N4") <br />
                        <strong>المعادل بالجنيه:</strong> @egpValue.ToString("N2") ج.م
                    </div>
                }
            </div>
        </div>

        <!-- Voucher Details -->
        @if (Model.PassengerDetails != null && Model.PassengerDetails.Any())
        {
            <div class="mt-4 mb-4">
                <div class="fw-bold mb-2 text-dark" style="font-size: 1.1rem;">تفاصيل دفعات المسافرين (الملفات والمجموعات):</div>
                <table class="table table-sm table-bordered text-center align-middle" style="border-color: #2b2d42;">
                    <thead>
                        <tr style="background-color: #2b2d42; color: #fff;">
                            <th style="background-color: #2b2d42 !important; color: #fff !important; width: 60px;">م</th>
                            <th style="background-color: #2b2d42 !important; color: #fff !important;">اسم المسافر</th>
                            <th style="background-color: #2b2d42 !important; color: #fff !important; width: 150px;">رقم الملف</th>
                            <th style="background-color: #2b2d42 !important; color: #fff !important; width: 140px;">رقم المجموعة</th>
                            <th style="background-color: #2b2d42 !important; color: #fff !important; width: 150px;">المبلغ المسدد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 1; }
                        @foreach (var detail in Model.PassengerDetails)
                        {
                            <tr>
                                <td>@idx</td>
                                <td class="text-start ps-3 fw-semibold">@detail.PassengerName</td>
                                <td class="font-monospace">@detail.BookingNumber</td>
                                <td>@(string.IsNullOrWhiteSpace(detail.GroupNumber) ? "-" : detail.GroupNumber)</td>
                                <td class="fw-bold text-success">@detail.AmountPaid.ToString("N2") ج.م</td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="detail-row">
                <span class="detail-label">@partyLabel:</span>
                <span class="detail-val fw-bold">@Model.DepositorOrWithdrawerName</span>
            </div>
        }

        <div class="detail-row">
            <span class="detail-label">التبعية لشيت (الشريك):</span>
            <span class="detail-val">@(Model.AssociatedPartnerName == "Corporate / Treasury" ? "الخزينة العامة للشركة" : "شيت الشريك: " + Model.AssociatedPartnerName)</span>
        </div>

        <div class="detail-row">
            <span class="detail-label">طريقة الدفع / البنك:</span>
            <span class="detail-val">@(string.IsNullOrEmpty(Model.BankName) ? "درج النقدية (كاش)" : Model.BankName)</span>
        </div>

        <div class="detail-row" style="border-bottom: 2px solid #2b2d42;">
            <span class="detail-label">البيان وسبب الحركة:</span>
            <span class="detail-val">@Model.Description</span>
        </div>

        <!-- Signatures and Stamp -->
        <div class="signatures-section row g-3">
            <div class="col-md-3 col-3">
                <div class="sig-box">
                    <p class="mb-5">توقيع المستلم/المودع</p>
                    <div class="border-top border-dark mx-3"></div>
                </div>
            </div>
            <div class="col-md-3 col-3">
                <div class="sig-box">
                    <p class="mb-5">توقيع أمين الصندوق</p>
                    <div class="border-top border-dark mx-3"></div>
                </div>
            </div>
            <div class="col-md-3 col-3 text-center">
                <div class="official-stamp">
                    الختم الرسمي
                </div>
            </div>
            <div class="col-md-3 col-3">
                <div class="sig-box">
                    <p class="mb-5">توقيع المدير المسؤول</p>
                    <div class="border-top border-dark mx-3"></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
