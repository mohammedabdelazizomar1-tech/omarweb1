@model BusinessManagement.Application.DTOs.CustomerDetailsDto
@{
    Layout = null;
    var history = ViewBag.History as IEnumerable<BusinessManagement.Application.DTOs.CustomerBookingHistoryDto> ?? new List<BusinessManagement.Application.DTOs.CustomerBookingHistoryDto>();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>تقرير ملف العميل: @Model.FullName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #fff;
            color: #000;
            padding: 30px;
        }
        .report-header {
            border-bottom: 3px double #000;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .section-title {
            background-color: #f2f2f2;
            padding: 8px 15px;
            font-weight: bold;
            border-right: 5px solid #000;
            margin-top: 25px;
            margin-bottom: 15px;
        }
        .info-label {
            font-weight: bold;
            color: #444;
        }
        @@media print {
            body {
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Print trigger button (visible on screen only) -->
    <div class="no-print text-end mb-4">
        <button onclick="window.print();" class="btn btn-primary btn-sm"><i class="bi bi-printer"></i> طباعة الصفحة</button>
        <button onclick="window.close();" class="btn btn-outline-secondary btn-sm">إغلاق النافذة</button>
    </div>

    <!-- Company Logo and Header -->
    <div class="report-header d-flex justify-content-between align-items-center">
        <div>
            <h2>شركة خدمات الحج والعمرة والسياحة</h2>
            <p class="text-muted m-0">سجل وثائق العملاء والمسافرين الموحد</p>
        </div>
        <div class="text-end">
            <p class="m-0">تاريخ التقرير: @DateTime.Now.ToString("yyyy-MM-dd hh:mm tt")</p>
            <p class="m-0">مُصدر التقرير: نظام الإدارة الإلكتروني</p>
        </div>
    </div>

    <!-- Customer Info -->
    <div class="section-title">البيانات الأساسية للمسافر</div>
    <div class="row g-3">
        <div class="col-md-6 col-6">
            <span class="info-label">الاسم بالكامل: </span>
            <span>@Model.FullName</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">الجنسية: </span>
            <span>@Model.Nationality</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">رقم جواز السفر: </span>
            <span style="font-family: monospace;">@Model.PassportNumber</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">انتهاء جواز السفر: </span>
            <span>@(Model.PassportExpiry.HasValue ? Model.PassportExpiry.Value.ToString("yyyy-MM-dd") : "-")</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">الرقم القومي: </span>
            <span>@Model.NationalId</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">تاريخ الميلاد: </span>
            <span>@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "-")</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">الجنس: </span>
            <span>@(Model.Gender == "Male" ? "ذكر" : "أنثى")</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">رقم الهاتف: </span>
            <span>@Model.PhoneNumber</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">البريد الإلكتروني: </span>
            <span>@Model.Email</span>
        </div>
        <div class="col-md-6 col-6">
            <span class="info-label">العنوان: </span>
            <span>@Model.Address</span>
        </div>
    </div>

    <!-- Bookings History -->
    <div class="section-title">سجل الرحلات والحجوزات والوضع المالي</div>
    <table class="table table-bordered table-striped" style="font-size: 0.9rem;">
        <thead class="table-dark">
                <tr>
                    <th>رقم الحجز</th>
                    <th>شيت التبعية</th>
                    <th>بوابة QR</th>
                    <th>تاريخ السفر</th>
                    <th>سعر البيع</th>
                    <th>المدفوع</th>
                    <th>المتبقي</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @if (!history.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-3">لا توجد حجوزات سابقة مسجلة لهذا العميل.</td>
                    </tr>
                }
                else
                {
                    foreach (var h in history)
                    {
                        <tr>
                            <td class="fw-bold">@h.BookingNumber</td>
                            <td>@h.PartnerName</td>
                            <td>@h.QrStatus</td>
                        <td>@h.TravelDate.ToString("yyyy-MM-dd")</td>
                        <td>@h.SellingPrice.ToString("N2") ج.م</td>
                        <td>@h.AmountPaid.ToString("N2") ج.م</td>
                        <td>@h.RemainingBalance.ToString("N2") ج.م</td>
                        <td>@h.Status</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="mt-5 text-center text-muted" style="font-size: 0.8rem;">
        شركة خدمات الحج والعمرة - نهاية تقرير وثائق العميل المطبوع
    </div>

    <script>
        // Trigger print automatically when page finishes rendering
        window.onload = function () {
            window.print();
        }
    </script>
</body>
</html>
