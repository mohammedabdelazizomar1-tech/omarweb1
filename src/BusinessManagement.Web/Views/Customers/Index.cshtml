                                confirmButtonText: 'حسناً'
                            });
                        } else {
                            alert(result.message);
                        }
                    }
                })
                .catch(error => {
                    if (window.Swal) {
                        Swal.close();
                    }
                    console.error('Customer group import error:', error);
                    if (window.Swal) {
                        Swal.fire({
                            title: 'خطأ',
                            text: 'فشل استيراد مجموعة العملاء من ملف Excel.',
                            icon: 'error',
