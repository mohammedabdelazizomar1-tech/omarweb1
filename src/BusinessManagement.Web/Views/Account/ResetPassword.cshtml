@model BusinessManagement.Application.DTOs.ResetPasswordDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="glass-card p-4 shadow-lg text-right" style="max-width: 450px; width: 100%;">
        <div class="text-center mb-4">
            <h4 class="text-white fw-bold mb-2">إعادة تعيين كلمة المرور</h4>
            <p class="text-muted small">أدخل كلمة المرور الجديدة وتأكيدها لحسابك</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="mb-3">
                <label class="form-label text-secondary small">البريد الإلكتروني للطلب</label>
                <input class="form-control" value="@Model.Email" readonly disabled />
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label text-secondary small">كلمة المرور الجديدة</label>
                <input asp-for="NewPassword" class="form-control" placeholder="******" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label text-secondary small">تأكيد كلمة المرور الجديدة</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="******" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3">تحديث كلمة المرور</button>
            
            <div class="text-center mt-3">
                <a href="/Account/Login" class="text-muted small text-decoration-none">
                    العودة لتسجيل الدخول
                </a>
            </div>
        </form>
    </div>
</div>
