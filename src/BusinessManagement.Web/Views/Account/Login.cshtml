@model BusinessManagement.Application.DTOs.LoginRequestDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

<div class="login-wrapper">
    <div class="login-card glass-card">
        <div class="text-center mb-4">
            <div class="bg-primary text-white rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 54px; height: 54px; box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);">
                <i class="bi bi-grid-1x2-fill" style="font-size: 1.75rem;"></i>
            </div>
            <h3 class="text-white fw-bold">Welcome Back</h3>
            <p class="text-muted small">Access your Business Operations console</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="UsernameOrEmail" class="form-label">Username or Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                        <i class="bi bi-person"></i>
                    </span>
                    <input asp-for="UsernameOrEmail" class="form-control border-start-0" placeholder="e.g. admin or admin@BusinessManagement.com" autofocus />
                </div>
                <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input asp-for="Password" type="password" class="form-control border-start-0 border-end-0" placeholder="••••••••" id="password-field" />
                    <button type="button" class="btn input-group-text bg-transparent border-start-0" style="border-color: var(--border-color); color: var(--text-secondary); cursor: pointer; box-shadow: none;" id="toggle-password">
                        <i class="bi bi-eye" id="toggle-password-icon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggle-password').addEventListener('click', function () {
            const passwordField = document.getElementById('password-field');
            const toggleIcon = document.getElementById('toggle-password-icon');
            
            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordField.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        });
    </script>
}




