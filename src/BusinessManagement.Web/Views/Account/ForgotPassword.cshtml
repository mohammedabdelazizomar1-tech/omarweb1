@model BusinessManagement.Application.DTOs.ForgotPasswordDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "استعادة كلمة المرور";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="glass-card p-4 shadow-lg text-right" style="max-width: 450px; width: 100%;">
        <div class="text-center mb-4">
            <h4 class="text-white fw-bold mb-2">استعادة كلمة المرور</h4>
            <p class="text-muted small">أدخل بريدك الإلكتروني المسجل وسنقوم بإرسال رابط الاستعادة</p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info border-0 text-center small mb-4 py-2" style="background-color: rgba(59, 130, 246, 0.1); color: #60a5fa;">
                @ViewBag.Message
            </div>
            @if (ViewBag.ResetLink != null)
            {
                <div class="mb-4 p-2 text-center rounded border border-secondary bg-dark text-break">
                    <span class="text-secondary small d-block mb-1">رابط استعادة كلمة المرور للتجربة:</span>
                    <a href="@ViewBag.ResetLink" class="text-primary small fw-bold">@ViewBag.ResetLink</a>
                </div>
            }
        }

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label text-secondary small">البريد الإلكتروني</label>
                <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3">إرسال رابط الاستعادة</button>
            
            <div class="text-center mt-3">
                <a href="/Account/Login" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-right-short me-1"></i> العودة لتسجيل الدخول
                </a>
            </div>
        </form>
    </div>
</div>
