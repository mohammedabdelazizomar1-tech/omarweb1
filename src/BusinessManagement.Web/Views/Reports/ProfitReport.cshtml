@model BusinessManagement.Application.DTOs.ProfitReportDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "تقرير صافي الأرباح والربحية";
    string fromDate = ViewBag.FromDate;
    string toDate = ViewBag.ToDate;
}

<div class="container-fluid py-4 text-right">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <div>
            <h4 class="text-white fw-bold m-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i> تقرير تحليل الأرباح وهامش الربحية</h4>
            <p class="text-muted small m-0">بيان تفصيلي بصافي الربح المحقق مقارنةً بهيكل التكاليف والمصروفات وهوامش الربحية للفترة.</p>
        </div>
        <div class="d-flex gap-2 no-print">
            <a href="/Reports/ExportProfitExcel?fromDate=@fromDate&toDate=@toDate" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
            <button onclick="window.print();" class="btn btn-outline-info btn-sm"><i class="bi bi-printer"></i> طباعة / PDF</button>
            <a href="/Reports" class="btn btn-outline-secondary btn-sm">العودة</a>
        </div>
    </div>

    <!-- Filters -->
    <div class="glass-card p-3 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-secondary small">من تاريخ</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control" />
            </div>
            <div class="col-md-5">
                <label class="form-label text-secondary small">إلى تاريخ</label>
                <input type="date" name="toDate" value="@toDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> تصفية</button>
            </div>
        </form>
    </div>

    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="glass-card p-3 border-start border-success border-4">
                <small class="text-muted">إجمالي الإيرادات</small>
                <h3 class="text-success fw-bold m-0 mt-1">@Model.TotalRevenues.ToString("N2") ج.م</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-3 border-start border-danger border-4">
                <small class="text-muted">إجمالي المصروفات</small>
                <h3 class="text-danger fw-bold m-0 mt-1">@Model.TotalExpenses.ToString("N2") ج.م</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-3 border-start border-primary border-4" style="background-color: rgba(59, 130, 246, 0.05);">
                <small class="text-muted">صافي الأرباح المحققة</small>
                <h3 class="text-primary fw-bold m-0 mt-1">@Model.NetProfit.ToString("N2") ج.م</h3>
                <span class="text-muted small mt-1 d-block">هامش الربحية: <strong class="text-white">@Model.ProfitMarginPercentage.ToString("F1")%</strong></span>
            </div>
        </div>
    </div>

    <!-- Chart Block -->
    <div class="glass-card p-4 mb-4">
        <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">مخطط مقارنة الإيرادات والمصروفات وصافي الربح شهرياً</h6>
        <div style="height: 320px;">
            <canvas id="profitComparisonChart"></canvas>
        </div>
    </div>

    <!-- Monthly timeline Table -->
    <div class="glass-card p-4">
        <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">جدول الأداء المالي الشهري التفصيلي</h6>
        <div class="table-responsive">
            <table class="BusinessManagement-table text-nowrap table-hover" style="font-size: 0.85rem;">
                <thead>
                    <tr>
                        <th>الشهر</th>
                        <th class="text-end">الإيرادات (ج.م)</th>
                        <th class="text-end">المصروفات (ج.م)</th>
                        <th class="text-end">صافي الأرباح (ج.م)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.ProfitTimeline)
                    {
                        <tr>
                            <td class="fw-bold text-white">@t.MonthName</td>
                            <td class="text-end text-success font-monospace">@t.Revenue.ToString("N2")</td>
                            <td class="text-end text-danger font-monospace">@t.Expense.ToString("N2")</td>
                            <td class="text-end fw-bold text-info font-monospace">@t.Profit.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Chart.js scripts -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById("profitComparisonChart").getContext("2d");
            
            const months = [];
            const revenues = [];
            const expenses = [];
            const profits = [];
            
            @foreach (var t in Model.ProfitTimeline)
            {
                <text>
                months.push("@t.MonthName");
                revenues.push(@t.Revenue);
                expenses.push(@t.Expense);
                profits.push(@t.Profit);
                </text>
            }
            
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: months,
                    datasets: [
                        {
                            label: 'الإيرادات',
                            data: revenues,
                            backgroundColor: 'rgba(16, 185, 129, 0.4)',
                            borderColor: '#10b981',
                            borderWidth: 1
                        },
                        {
                            label: 'المصروفات',
                            data: expenses,
                            backgroundColor: 'rgba(239, 68, 68, 0.4)',
                            borderColor: '#ef4444',
                            borderWidth: 1
                        },
                        {
                            label: 'صافي الربح',
                            data: profits,
                            type: 'line',
                            borderColor: '#3b82f6',
                            backgroundColor: '#3b82f6',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#9ca3af' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9ca3af' }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: { color: '#f3f4f6', font: { family: 'Cairo' } }
                        }
                    }
                }
            });
        });
    </script>
}
