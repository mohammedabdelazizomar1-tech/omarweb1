@model BusinessManagement.Application.DTOs.CustomerReportDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "تقرير العملاء والمسافرين";
    string fromDate = ViewBag.FromDate;
    string toDate = ViewBag.ToDate;
}

<div class="container-fluid py-4 text-right">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <div>
            <h4 class="text-white fw-bold m-0"><i class="bi bi-people-fill text-primary me-2"></i> تقرير إحصائيات العملاء والمسافرين</h4>
            <p class="text-muted small m-0">تحليل بيانات المسافرين المسجلين، الجنسيات، والمجموعات السياحية الأكثر نشاطاً.</p>
        </div>
        <div class="d-flex gap-2 no-print">
            <a href="/Reports/ExportCustomerExcel?fromDate=@fromDate&toDate=@toDate" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
            <button onclick="window.print();" class="btn btn-outline-info btn-sm"><i class="bi bi-printer"></i> طباعة / PDF</button>
            <a href="/Reports" class="btn btn-outline-secondary btn-sm">العودة</a>
        </div>
    </div>

    <!-- Filters -->
    <div class="glass-card p-3 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-secondary small">من تاريخ تسجيل</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control" />
            </div>
            <div class="col-md-5">
                <label class="form-label text-secondary small">إلى تاريخ تسجيل</label>
                <input type="date" name="toDate" value="@toDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> تصفية</button>
            </div>
        </form>
    </div>

    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="glass-card p-3 border-start border-primary border-4">
                <small class="text-muted">إجمالي عدد المسافرين (CRM)</small>
                <h3 class="text-white fw-bold m-0 mt-1">@Model.TotalCustomers</h3>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="glass-card p-3 border-start border-success border-4">
                <small class="text-muted">عدد المجموعات السياحية</small>
                <h3 class="text-white fw-bold m-0 mt-1">@Model.TotalGroups</h3>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Nationality Chart -->
        <div class="col-md-6">
            <div class="glass-card p-4">
                <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">توزيع المسافرين حسب الجنسية</h6>
                <div class="table-responsive">
                    <table class="BusinessManagement-table">
                        <thead>
                            <tr>
                                <th>الجنسية</th>
                                <th class="text-end">عدد المسافرين</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in Model.CustomersByNationality)
                            {
                                <tr>
                                    <td class="text-white">@n.Key</td>
                                    <td class="text-end fw-bold text-primary">@n.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Gender Breakdown -->
        <div class="col-md-6">
            <div class="glass-card p-4">
                <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">توزيع الجنس (النوع الاجتماعي)</h6>
                <div class="table-responsive">
                    <table class="BusinessManagement-table">
                        <thead>
                            <tr>
                                <th>الجنس</th>
                                <th class="text-end">العدد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model.CustomersByGender)
                            {
                                <tr>
                                    <td class="text-white">@g.Key</td>
                                    <td class="text-end fw-bold text-info">@g.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Most Active Customers -->
        <div class="col-12">
            <div class="glass-card p-4">
                <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">المسافرون الأكثر حجزاً وتعاملاً</h6>
                <div class="table-responsive">
                    <table class="BusinessManagement-table text-nowrap">
                        <thead>
                            <tr>
                                <th>اسم المسافر</th>
                                <th>رقم جواز السفر</th>
                                <th class="text-end">عدد الحجوزات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.MostFrequentCustomers)
                            {
                                <tr>
                                    <td class="fw-bold text-white">@c.Name</td>
                                    <td class="text-muted font-monospace">@c.PassportNumber</td>
                                    <td class="text-end fw-bold text-success">@c.BookingsCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
