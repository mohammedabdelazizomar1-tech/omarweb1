@model BusinessManagement.Application.DTOs.CashReportDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "تقرير الخزينة الكاش";
    string fromDate = ViewBag.FromDate;
    string toDate = ViewBag.ToDate;
}

<div class="container-fluid py-4 text-right">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <div>
            <h4 class="text-white fw-bold m-0"><i class="bi bi-wallet2 text-warning me-2"></i> تقرير الخزينة والتدفقات النقدية (Cash Flow)</h4>
            <p class="text-muted small m-0">رصد حركة المقبوضات والمدفوعات اليومية وصافي الأرصدة المتوفرة بالعملات المختلفة.</p>
        </div>
        <div class="d-flex gap-2 no-print">
            <a href="/Reports/ExportCashExcel?fromDate=@fromDate&toDate=@toDate" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
            <button onclick="window.print();" class="btn btn-outline-info btn-sm"><i class="bi bi-printer"></i> طباعة / PDF</button>
            <a href="/Reports" class="btn btn-outline-secondary btn-sm">العودة</a>
        </div>
    </div>

    <!-- Filters -->
    <div class="glass-card p-3 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-secondary small">من تاريخ حركة</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control" />
            </div>
            <div class="col-md-5">
                <label class="form-label text-secondary small">إلى تاريخ حركة</label>
                <input type="date" name="toDate" value="@toDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> تصفية</button>
            </div>
        </form>
    </div>

    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="glass-card p-3 border-start border-success border-4">
                <small class="text-muted">رصيد الخزينة الحالي (ج.م)</small>
                <h3 class="text-success fw-bold m-0 mt-1">@Model.CurrentSafeEgpBalance.ToString("N2") ج.م</h3>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="glass-card p-3 border-start border-warning border-4">
                <small class="text-muted">رصيد الخزينة الحالي (ر.س)</small>
                <h3 class="text-warning fw-bold m-0 mt-1">@Model.CurrentSafeSarBalance.ToString("N2") ر.س</h3>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="glass-card p-3 border-start border-info border-4">
                <small class="text-muted">إجمالي المقبوضات (الفترة)</small>
                <h5 class="text-white fw-bold m-0 mt-1">EGP: @Model.TotalEgpDeposits.ToString("N2")</h5>
                <h5 class="text-white fw-bold m-0">SAR: @Model.TotalSarDeposits.ToString("N2")</h5>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="glass-card p-3 border-start border-danger border-4">
                <small class="text-muted">إجمالي المدفوعات (الفترة)</small>
                <h5 class="text-white fw-bold m-0 mt-1">EGP: @Model.TotalEgpWithdrawals.ToString("N2")</h5>
                <h5 class="text-white fw-bold m-0">SAR: @Model.TotalSarWithdrawals.ToString("N2")</h5>
            </div>
        </div>
    </div>

    <!-- Transactions List Table -->
    <div class="glass-card p-4">
        <h6 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">بيان تفصيلي بحركات الصندوق والنقدية المسجلة</h6>
        <div class="table-responsive">
            <table class="BusinessManagement-table text-nowrap table-hover" style="font-size: 0.85rem;">
                <thead>
                    <tr>
                        <th>تاريخ الحركة</th>
                        <th>رقم القيد/المستند</th>
                        <th>نوع الحركة</th>
                        <th>المبلغ</th>
                        <th>العملة</th>
                        <th>البيان / التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.TransactionsList.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">لا توجد حركات نقدية مسجلة للفترة المحددة.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model.TransactionsList)
                        {
                            <tr>
                                <td class="text-muted">@t.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-bold text-white">@t.ReferenceNumber</td>
                                <td>
                                    <span class="badge @(t.Type == "إيداع" ? "bg-success" : "bg-danger")">@t.Type</span>
                                </td>
                                <td class="text-end fw-bold font-monospace @(t.Type == "إيداع" ? "text-success" : "text-danger")">
                                    @(t.Type == "إيداع" ? $"+{t.Amount.ToString("N2")}" : $"-{t.Amount.ToString("N2")}")
                                </td>
                                <td><span class="badge bg-secondary">@t.Currency</span></td>
                                <td class="text-wrap text-muted" style="max-width: 300px;">@t.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
