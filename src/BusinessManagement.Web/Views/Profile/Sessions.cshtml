@model IEnumerable<BusinessManagement.Domain.Entities.Session>
@{
    Layout = "_Layout";
    ViewData["Title"] = "إدارة جلسات تسجيل الدخول النشطة";
}

<div class="container-fluid py-4 text-right">
    <div class="glass-card p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom border-secondary pb-3">
            <div>
                <h5 class="text-white fw-bold m-0"><i class="bi bi-shield-lock-fill text-primary me-2"></i> جلسات تسجيل الدخول النشطة</h5>
                <p class="text-muted small m-0">راقب الأجهزة والمتصفحات النشطة حالياً التي سجلت الدخول بحسابك، وقم بإنهاء أي جلسة مشكوك فيها.</p>
            </div>
            
            <form asp-action="RevokeAllOtherSessions" method="post" onsubmit="return confirm('هل أنت متأكد من تسجيل الخروج من جميع الأجهزة الأخرى؟')">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-box-arrow-left me-2"></i> إنهاء الجلسات الأخرى (تسجيل خروج جماعي)
                </button>
            </form>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success border-0 small mb-4 py-2" style="background-color: rgba(16, 185, 129, 0.1); color: #34d399;">
                @ViewBag.SuccessMessage
            </div>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger border-0 small mb-4 py-2" style="background-color: rgba(239, 68, 68, 0.1); color: #f87171;">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="table-responsive">
            <table class="BusinessManagement-table text-nowrap table-hover" style="font-size: 0.85rem;">
                <thead class="bg-light">
                    <tr>
                        <th>الجهاز والمتصفح</th>
                        <th>عنوان الـ IP</th>
                        <th>تاريخ الدخول</th>
                        <th>تاريخ الانتهاء</th>
                        <th>الحالة</th>
                        <th class="text-end">الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        bool isCurrent = s.IpAddress == ViewBag.CurrentIp && s.UserAgent == ViewBag.CurrentUserAgent;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (s.UserAgent.Contains("Windows"))
                                    {
                                        <i class="bi bi-windows fs-5 text-primary"></i>
                                    }
                                    else if (s.UserAgent.Contains("Android") || s.UserAgent.Contains("iPhone"))
                                    {
                                        <i class="bi bi-phone-fill fs-5 text-info"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-laptop fs-5 text-secondary"></i>
                                    }
                                    <div class="text-truncate" style="max-width: 250px;" title="@s.UserAgent">
                                        @s.UserAgent
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-dark border border-secondary text-white fw-bold">@s.IpAddress</span>
                            </td>
                            <td class="text-white">@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                            <td class="text-muted">@s.ExpiresAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                            <td>
                                @if (isCurrent)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> هذا الجهاز حالياً</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">نشط</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!isCurrent)
                                {
                                    <form asp-action="RevokeSession" method="post" style="display:inline;" onsubmit="return confirm('هل أنت متأكد من إنهاء جلسة تسجيل الدخول للجهاز المحدد؟')">
                                        <input type="hidden" name="token" value="@s.Token" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="إنهاء الجلسة">
                                            <i class="bi bi-trash-fill"></i> إنهاء الجلسة
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
