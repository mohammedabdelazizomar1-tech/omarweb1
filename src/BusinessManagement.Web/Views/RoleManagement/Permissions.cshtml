@model IEnumerable<BusinessManagement.Domain.Entities.Permission>
@{
    Layout = "_Layout";
    var role = ViewBag.Role as BusinessManagement.Domain.Entities.Role;
    var mappedPermissionIds = ViewBag.MappedPermissionIds as List<Guid> ?? new List<Guid>();
    ViewData["Title"] = $"صلاحيات دور {role?.Name}";
}

<div class="container-fluid py-4 text-right">
    <div class="glass-card p-4">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 border-bottom border-secondary pb-3">
            <div>
                <h5 class="text-white fw-bold m-0"><i class="bi bi-key-fill text-primary me-2"></i> تعديل صلاحيات دور: <span class="text-primary">@role?.Name</span></h5>
                <p class="text-muted small m-0">حدد الصلاحيات الممنوحة لموظفي ومستخدمي هذا الدور بالنظام بالأسفل.</p>
            </div>
            
            <a href="/RoleManagement" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right-short me-1"></i> العودة لقائمة الأدوار
            </a>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success border-0 small mb-4 py-2" style="background-color: rgba(16, 185, 129, 0.1); color: #34d399;">
                @ViewBag.SuccessMessage
            </div>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger border-0 small mb-4 py-2" style="background-color: rgba(239, 68, 68, 0.1); color: #f87171;">
                @ViewBag.ErrorMessage
            </div>
        }

        <form asp-action="UpdateRolePermissions" method="post">
            <input type="hidden" name="roleId" value="@role?.Id" />

            <div class="table-responsive mb-4">
                <table class="BusinessManagement-table text-nowrap table-hover" style="font-size: 0.85rem;">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">منح</th>
                            <th>كود الصلاحية (System Code)</th>
                            <th>توصيف الصلاحية باللغة العربية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var perm in Model)
                        {
                            bool hasPerm = mappedPermissionIds.Contains(perm.Id);
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" name="selectedPermissions" value="@perm.Id" class="form-check-input" @(hasPerm ? "checked" : "") />
                                </td>
                                <td class="text-white fw-semibold"><code>@perm.Code</code></td>
                                <td class="text-muted">@perm.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn btn-primary px-4 py-2">
                <i class="bi bi-save me-1"></i> حفظ وتحديث مصفوفة الصلاحيات
            </button>
        </form>
    </div>
</div>
