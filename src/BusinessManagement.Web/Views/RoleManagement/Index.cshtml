@model IEnumerable<BusinessManagement.Domain.Entities.Role>
@{
    Layout = "_Layout";
    ViewData["Title"] = "إدارة أدوار وصلاحيات النظام";
}

<div class="container-fluid py-4 text-right">
    <div class="row g-4">
        <!-- Main Panel: Roles list -->
        <div class="col-lg-8">
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success border-0 small mb-4 py-2" style="background-color: rgba(16, 185, 129, 0.1); color: #34d399;">
                    @ViewBag.SuccessMessage
                </div>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger border-0 small mb-4 py-2" style="background-color: rgba(239, 68, 68, 0.1); color: #f87171;">
                    @ViewBag.ErrorMessage
                </div>
            }

            <div class="glass-card p-4">
                <h5 class="text-white fw-bold mb-4 border-bottom border-secondary pb-3"><i class="bi bi-shield-lock me-2"></i> أدوار الصلاحية الحالية</h5>
                
                <div class="table-responsive">
                    <table class="BusinessManagement-table text-nowrap table-hover" style="font-size: 0.85rem;">
                        <thead class="bg-light">
                            <tr>
                                <th>اسم الدور</th>
                                <th>توصيف المجموعة</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model)
                            {
                                <tr>
                                    <td class="text-white fw-bold">@role.Name</td>
                                    <td class="text-muted">مجموعة صلاحيات دور @role.Name بالنظام</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="/RoleManagement/Permissions?roleId=@role.Id" class="btn btn-sm btn-primary">
                                                <i class="bi bi-key-fill me-1"></i> تعديل الصلاحيات
                                            </a>
                                            @if (role.Name != "Admin" && role.Name != "Partner")
                                            {
                                                <form asp-action="DeleteRole" method="post" onsubmit="return confirm('هل أنت متأكد من حذف دور الصلاحية بالكامل؟')" style="display:inline;">
                                                    <input type="hidden" name="id" value="@role.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar: Add Role Form -->
        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h5 class="text-white fw-bold mb-4 border-bottom border-secondary pb-3"><i class="bi bi-plus-circle-fill text-primary me-2"></i> إضافة دور جديد</h5>
                
                <form asp-action="CreateRole" method="post">
                    <div class="mb-3">
                        <label class="form-label text-secondary small">اسم دور الصلاحية</label>
                        <input type="text" name="name" class="form-control" placeholder="مثال: Employee, Supervisor" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">حفظ الدور</button>
                </form>
            </div>
        </div>
    </div>
</div>
