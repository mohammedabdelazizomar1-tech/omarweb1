@model ErrorViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "System Error";
    string? errorMessage = Context.Request.Query["message"];
}

<div class="login-wrapper">
    <div class="login-card glass-card text-center" style="max-width: 500px;">
        <div class="text-danger mb-4">
            <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; box-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">
                <i class="bi bi-bug-fill" style="font-size: 2.25rem;"></i>
            </div>
            <h3 class="text-white fw-bold">System Exception</h3>
            <p class="text-muted small">An error occurred while processing your request.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger bg-transparent text-danger border-danger border-opacity-25 text-start mb-4" style="font-size: 0.9rem;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @errorMessage
            </div>
        }

        <div class="text-muted small mb-4">
            @if (Model.ShowRequestId)
            {
                <span>Request Trace ID: <code>@Model.RequestId</code></span>
            }
        </div>

        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary w-50 py-2">
                <i class="bi bi-arrow-left me-1"></i> Go Back
            </a>
            <a href="/" class="btn btn-primary w-50 py-2">
                <i class="bi bi-house-door-fill me-1"></i> Dashboard
            </a>
        </div>
    </div>
</div>
