@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}

<div class="login-wrapper">
    <div class="login-card glass-card text-center">
        <div class="text-danger mb-4">
            <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; box-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">
                <i class="bi bi-shield-slash-fill" style="font-size: 2.25rem;"></i>
            </div>
            <h3 class="text-white fw-bold">Access Denied</h3>
            <p class="text-muted small">You do not have the required security privileges to access this system module.</p>
        </div>

        <a href="/" class="btn btn-primary w-100 py-2">
            <i class="bi bi-house-door-fill me-2"></i> Return to Dashboard
        </a>
    </div>
</div>
