@model IEnumerable<Bms.Application.DTOs.PassengerDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "قاعدة بيانات المسافرين";
}

<div class="glass-card p-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h5 class="text-white fw-bold m-0">قاعدة بيانات المسافرين (CRM)</h5>
            <p class="text-muted small m-0">إدارة أرقام جوازات السفر، أرقام الهواتف، وملفات المسافرين المسجلة</p>
        </div>
        
        <div class="d-flex align-items-center gap-2">
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--border-color); color: var(--text-secondary);">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="passengerSearch" class="form-control border-start-0 text-white" placeholder="ابحث عن مسافر..." autocomplete="off" />
            </div>
            
            <button class="btn btn-primary" onclick="openCreatePassengerModal()">
                <i class="bi bi-person-plus-fill me-2"></i> إضافة مسافر جديد
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="bms-table" id="passengersTable">
            <thead>
                <tr>
                    <th>اسم المسافر بالكامل</th>
                    <th>رقم جواز السفر</th>
                    <th>الجنسية</th>
                    <th>تاريخ الميلاد</th>
                    <th>رقم الهاتف</th>
                    <th>تاريخ التسجيل</th>
                    <th class="text-end">العمليات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="7" class="text-center text-muted py-5">لا توجد ملفات مسافرين مسجلة حالياً.</td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model)
                    {
                        <tr class="passenger-row">
                            <td class="fw-semibold text-white">@p.FullName</td>
                            <td class="font-monospace fw-bold text-white">@p.PassportNumber</td>
                            <td>@p.Nationality</td>
                            <td>@(p.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>@(string.IsNullOrEmpty(p.PhoneNumber) ? "-" : p.PhoneNumber)</td>
                            <td>@p.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-end">
                                <a href="/Bookings/Create?passengerId=@p.Id" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="تسجيل حجز جديد لهذا المسافر">
                                    <i class="bi bi-file-earmark-plus-fill me-1"></i> تسجيل حجز
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Container Placeholder for Passenger Registration -->
<div class="modal fade" id="passengerModalElement" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white fw-bold">إضافة ملف مسافر جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
            </div>
            <form asp-controller="Bookings" asp-action="CreatePassenger" method="post" onsubmit="submitPassengerForm(event, this)">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label">اسم المسافر بالكامل *</label>
                        <input type="text" name="FullName" class="form-control" required placeholder="مثال: محمود فهمي" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">رقم جواز السفر *</label>
                        <input type="text" name="PassportNumber" class="form-control" required placeholder="مثال: A2394857" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الجنسية *</label>
                            <input type="text" name="Nationality" class="form-control" required value="Egyptian" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">تاريخ الميلاد</label>
                            <input type="date" name="DateOfBirth" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">رقم الهاتف</label>
                        <input type="text" name="PhoneNumber" class="form-control" placeholder="مثال: 01222222222" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-2"></i> إضافة ملف المسافر
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side search filters
        document.getElementById("passengerSearch").addEventListener("input", (e) => {
            const query = e.target.value.toLowerCase();
            const rows = document.querySelectorAll(".passenger-row");

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(query) ? "" : "none";
            });
        });

        // Open passenger modal
        function openCreatePassengerModal() {
            const modalEl = document.getElementById("passengerModalElement");
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        // Submit form via AJAX
        async function submitPassengerForm(event, form) {
            event.preventDefault();

            if (window.jQuery) {
                const $form = window.jQuery(form);
                if ($form.data("validator") && !$form.valid()) {
                    return;
                }
            }

            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            try {
                const result = await bmsAjax(form.action, form.method, formData);
                if (result.success) {
                    bmsAlert(result.message, "success");
                    
                    const modalEl = document.getElementById("passengerModalElement");
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();

                    setTimeout(() => location.reload(), 1000);
                } else {
                    bmsAlert(result.message, "danger");
                    submitBtn.disabled = false;
                }
            } catch (error) {
                console.error("Passenger submit error:", error);
                submitBtn.disabled = false;
            }
        }
    </script>
}
