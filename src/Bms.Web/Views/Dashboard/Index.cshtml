@model Bms.Application.DTOs.TravelDashboardDto
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "لوحة تحكم عمليات الحج والعمرة";
}

<!-- KPI Cards Grid -->
<div class="row g-3 mb-4">
    <!-- EGP Cash Safe -->
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 50px; height: 50px;">
                <i class="bi bi-wallet2 fs-4"></i>
            </div>
            <div>
                <small class="text-secondary d-block">خزينة الجنيه المصري (EGP)</small>
                <h4 class="text-white fw-bold m-0">@Model.SafeBalanceEgp.ToString("N2") <span class="fs-6 text-muted">ج.م</span></h4>
            </div>
        </div>
    </div>
    <!-- SAR Cash Safe -->
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success" style="width: 50px; height: 50px;">
                <i class="bi bi-cash-stack fs-4"></i>
            </div>
            <div>
                <small class="text-secondary d-block">خزينة الريال السعودي (SAR)</small>
                <h4 class="text-white fw-bold m-0">@Model.SafeBalanceSar.ToString("N2") <span class="fs-6 text-muted">ر.س</span></h4>
            </div>
        </div>
    </div>
    <!-- Available QRs -->
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info" style="width: 50px; height: 50px;">
                <i class="bi bi-qr-code fs-4"></i>
            </div>
            <div>
                <small class="text-secondary d-block">باركود البوابة المتاحة (QR)</small>
                <h4 class="text-white fw-bold m-0">@Model.AvailableQrCodes <span class="fs-6 text-muted">حصة</span></h4>
            </div>
        </div>
    </div>
    <!-- Available VIPs -->
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning" style="width: 50px; height: 50px;">
                <i class="bi bi-star-fill fs-4"></i>
            </div>
            <div>
                <small class="text-secondary d-block">حصة تأشيرات VIP المتاحة</small>
                <h4 class="text-white fw-bold m-0">@Model.AvailableVipSlots <span class="fs-6 text-muted">حصة</span></h4>
            </div>
        </div>
    </div>
</div>

<!-- Partnership Profits & Quotas Chart Panel -->
<div class="row g-4 mb-4">
    <!-- Left panel: Partner Quota Progress -->
    <div class="col-lg-6 col-md-12">
        <div class="glass-card p-4 h-100">
            <h5 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-steps text-primary"></i> توزيع كوتة البوابة للشركاء (`كوتة الباركود`)
            </h5>
            <div class="d-flex flex-column gap-3">
                @foreach (var pt in Model.PartnerQuotas)
                {
                    var percent = pt.QuotaLimit > 0 ? (pt.QrCount * 100) / pt.QuotaLimit : 0;
                    var progressColor = percent > 90 ? "bg-danger" : percent > 75 ? "bg-warning" : "bg-success";
                    
                    <div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold text-white">التابع للشريك: @pt.PartnerName</span>
                            <span class="small text-muted">@pt.QrCount / @pt.QuotaLimit حصة (@percent%)</span>
                        </div>
                        <div class="progress bg-dark" style="height: 10px; border-radius: 5px;">
                            <div class="progress-bar @progressColor" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <!-- Right panel: Quick Charts (Doughnut profit weight) -->
    <div class="col-lg-6 col-md-12">
        <div class="glass-card p-4 h-100">
            <h5 class="text-white fw-bold mb-3">
                <i class="bi bi-pie-chart-fill text-success"></i> حصص أرباح الشركاء
            </h5>
            <div style="max-height: 250px; position: relative;">
                <canvas id="profitChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Consolidated Financial KPIs -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="glass-card p-3 text-center" style="border-right: 4px solid var(--primary-color); border-left: none;">
            <div class="text-secondary small">إجمالي قيمة المبيعات</div>
            <h3 class="text-white fw-bold mt-2">$@Model.TotalSalesInvoiced.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center" style="border-right: 4px solid #10b981; border-left: none;">
            <div class="text-secondary small">إجمالي المبالغ المحصلة</div>
            <h3 class="text-white fw-bold mt-2">$@Model.TotalPaymentsCollected.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center" style="border-right: 4px solid #f59e0b; border-left: none;">
            <div class="text-secondary small">المبالغ المتبقية للتحصيل</div>
            <h3 class="text-white fw-bold mt-2">$@Model.TotalRemainingReceivable.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 text-center" style="border-right: 4px solid #3b82f6; border-left: none;">
            <div class="text-secondary small">صافي الأرباح المحققة</div>
            <h3 class="text-white fw-bold mt-2">$@Model.TotalAccumulatedProfit.ToString("N2")</h3>
        </div>
    </div>
</div>

<!-- Recent Traveler Files Table -->
<div class="glass-card p-4">
    <h5 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-file-earmark-person text-primary"></i> أحدث ملفات حجوزات المسافرين
    </h5>
    <div class="table-responsive">
        <table class="bms-table">
            <thead>
                <tr>
                    <th>رقم الملف</th>
                    <th>اسم المسافر</th>
                    <th>التبعية (شيت)</th>
                    <th>تاريخ السفر</th>
                    <th>قيمة الحجز</th>
                    <th class="text-center">كود بوابة (QR)</th>
                    <th class="text-center">حالة السداد</th>
                    <th class="text-end">العمليات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentBookings == null || !Model.RecentBookings.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">لا توجد سجلات حجز مسافرين حالياً.</td>
                    </tr>
                }
                else
                {
                    foreach (var b in Model.RecentBookings)
                    {
                        <tr>
                            <td class="fw-bold text-white">@b.BookingNumber</td>
                            <td class="fw-semibold text-white">@b.PassengerName</td>
                            <td>شيت الشريك: @b.PartnerName</td>
                            <td>@b.TravelDate.ToString("dd MMM yyyy")</td>
                            <td class="fw-semibold text-white">$@b.SellingPrice.ToString("N2")</td>
                            <td class="text-center">
                                @if (b.HasQrCode)
                                {
                                    <span class="badge bg-success">بـ QR</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">بدون QR</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (b.Status == "Paid")
                                {
                                    <span class="badge bg-success">مسدد بالكامل</span>
                                }
                                else if (b.Status == "Partial")
                                {
                                    <span class="badge bg-warning text-dark">جزئي</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white">غير مسدد</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Bookings/Edit/@b.BookingId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil-square"></i> تعديل
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- Local Chart.js Scripting -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const partnerLabels = @Html.Raw(JsonSerializer.Serialize(Model.PartnerQuotas.Select(q => "أرباح شيت: " + q.PartnerName)));
        const partnerProfits = @Html.Raw(JsonSerializer.Serialize(Model.PartnerQuotas.Select(q => (double)q.TotalProfit)));

        const ctx = document.getElementById('profitChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: partnerLabels,
                datasets: [{
                    label: 'توزيع الأرباح ($)',
                    data: partnerProfits,
                    backgroundColor: [
                        'rgba(59, 130, 246, 0.7)', // Blue
                        'rgba(16, 185, 129, 0.7)', // Green
                        'rgba(245, 158, 11, 0.7)', // Orange
                        'rgba(239, 68, 68, 0.7)'   // Red
                    ],
                    borderColor: [
                        '#3b82f6',
                        '#10b981',
                        '#f59e0b',
                        '#ef4444'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            color: '#94a3b8',
                            font: {
                                family: 'Cairo'
                            }
                        }
                    }
                }
            }
        });
    </script>
}
