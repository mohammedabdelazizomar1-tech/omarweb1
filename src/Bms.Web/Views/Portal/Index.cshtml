@model IEnumerable<Bms.Application.DTOs.GatewayPortalDto>
@using Bms.Domain.Enums
@{
    Layout = "_Layout";
    ViewData["Title"] = "بوابات التأشيرات والمنافذ";
    var partners = ViewBag.Partners as IEnumerable<Bms.Application.DTOs.PartnerQuotaMetric> ?? new List<Bms.Application.DTOs.PartnerQuotaMetric>();
}

<!-- Portal Inventory Balances HUD -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="glass-card p-4 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info" style="width: 60px; height: 60px;">
                <i class="bi bi-qr-code fs-3"></i>
            </div>
            <div>
                <small class="text-secondary d-block fw-semibold text-uppercase">أكواد بوابة السعودية المتاحة (QR)</small>
                <h2 class="text-white fw-bold m-0 mt-1">@ViewBag.AvailableQr <span class="fs-6 text-muted">كود بوابة نشط</span></h2>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="glass-card p-4 d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning" style="width: 60px; height: 60px;">
                <i class="bi bi-star-fill fs-3"></i>
            </div>
            <div>
                <small class="text-secondary d-block fw-semibold text-uppercase">إجمالي حصة بوابات VIP المشحونة</small>
                <h2 class="text-white fw-bold m-0 mt-1">@ViewBag.AvailableVip <span class="fs-6 text-muted">حصة</span></h2>
            </div>
        </div>
    </div>
</div>

<div class="glass-card p-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h5 class="text-white fw-bold m-0">سجل عمليات شحن بوابات التأشيرات (شيت BW)</h5>
            <p class="text-muted small m-0">تسجيل ومتابعة باقات التأشيرات المشحونة وتوزيع حصص كوتة البوابة للشركة</p>
        </div>
        
        <button class="btn btn-primary" onclick="openCreatePortalModal()">
            <i class="bi bi-plus-circle-fill me-2"></i> شحن كوتة البوابة
        </button>
    </div>

    <!-- Purchases table -->
    <div class="table-responsive">
        <table class="bms-table">
            <thead>
                <tr>
                    <th>تاريخ الشحن</th>
                    <th>نوع البوابة / الباقة</th>
                    <th>عدد الحصص المشحونة</th>
                    <th>تكلفة الحصة الواحدة</th>
                    <th>إجمالي تكلفة الشحن</th>
                    <th>حصة التوزيع للشريك</th>
                    <th>ملاحظات وتفاصيل الاستلام</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">لا توجد عمليات شحن لبوابات التأشيرات مسجلة حالياً.</td>
                    </tr>
                }
                else
                {
                    foreach (var pr in Model)
                    {
                        var unitCost = pr.Count > 0 ? pr.Amount / pr.Count : 0m;
                        <tr>
                            <td>@pr.TransactionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-primary bg-opacity-15 text-primary">@pr.ServiceType</span>
                            </td>
                            <td class="fw-bold text-white">@pr.Count حصة</td>
                            <td>@unitCost.ToString("N2") ج.م</td>
                            <td class="fw-bold text-white">@pr.Amount.ToString("N2") ج.م</td>
                            <td>@(pr.PartnerName == "General Corporate Quota" ? "الحصة العامة للشركة" : "شيت: " + pr.PartnerName)</td>
                            <td>@(string.IsNullOrEmpty(pr.Notes) ? "-" : pr.Notes)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Dialog Container for Portal Purchase -->
<div class="modal fade" id="portalModalElement" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white fw-bold">شحن باقة بوابة جديدة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
            </div>
            <form asp-controller="Portal" asp-action="Create" method="post" onsubmit="submitPortalForm(event, this)">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">نوع البوابة / الباقة *</label>
                            <select name="ServiceType" class="form-select" required>
                                <option value="QrCode">أكواد بوابة السعودية (QR)</option>
                                <option value="Vip">بوابة تأشيرات VIP</option>
                                <option value="UmrahPackage">باقة بوابة العمرة</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">عدد الحصص *</label>
                            <input type="number" name="Count" class="form-control" min="1" required placeholder="مثال: 50" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تكلفة الشراء الإجمالية (ج.م) *</label>
                        <input type="number" name="Amount" step="0.01" class="form-control" required placeholder="0.00" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توزيع الكوتة لشريك محدد (اختياري)</label>
                        <select name="PartnerId" class="form-select">
                            <option value="">كوتة الشركة العامة</option>
                            @foreach (var pt in partners)
                            {
                                <option value="@pt.PartnerId">شيت الشريك: @pt.PartnerName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تفاصيل الفاتورة والملاحظات</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="أدخل تفاصيل الدفع والاستلام للشركة الموردة..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-2"></i> تأكيد عملية الشحن
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreatePortalModal() {
            const modalEl = document.getElementById("portalModalElement");
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        async function submitPortalForm(event, form) {
            event.preventDefault();
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            try {
                const result = await bmsAjax(form.action, form.method, formData);
                if (result.success) {
                    bmsAlert(result.message, "success");
                    const modalEl = document.getElementById("portalModalElement");
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    bmsAlert(result.message, "danger");
                    submitBtn.disabled = false;
                }
            } catch (error) {
                console.error("Portal submit error:", error);
                submitBtn.disabled = false;
            }
        }
    </script>
}
